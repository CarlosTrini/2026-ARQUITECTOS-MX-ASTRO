---
import { ArrowUpRight, Section } from "lucide-astro";

interface Props {
  eyebrow: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  class?: string;
}

const {
  eyebrow,
  description,
  href,
  linkLabel,
  class: className = "",
} = Astro.props;
---

<div
  class={`flex flex-col md:flex-row md:items-end md:justify-between gap-6 ${className}`}
>
  <div class="max-w-2xl space-y-5">
    <p
      class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.25em] text-tertiary"
    >
      <Section class="w-4 h-4" />
      <span class="text-quinary">{eyebrow}</span>
    </p>
    <h2
      class="font-display text-3xl sm:text-4xl lg:text-5xl font-light leading-[1.1] tracking-tight text-light"
    >
      <slot />
    </h2>
    {
      description && (
        <p class="text-sm sm:text-base leading-relaxed text-light/70 max-w-xl">
          {description}
        </p>
      )
    }
  </div>
  {
    href && (
      <a
        href={href}
        class="group inline-flex w-fit items-center gap-2 border-b border-quaternary pb-1.5 font-mono text-[11px] uppercase tracking-[0.2em] text-light transition-colors hover:border-tertiary hover:text-tertiary"
      >
        <span>{linkLabel}</span>
        <ArrowUpRight class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
    )
  }
</div>
