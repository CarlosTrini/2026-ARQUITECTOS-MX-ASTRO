---
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import { teamMembers } from "../content/dataStatic/data";
---

<MainLayout
  title="Equipo & Filosofía | Arquitectos MX"
  description="Conoce al equipo de arquitectos directores, especialistas en diseño bioclimático, estructuras e interiorismo detrás de Arquitectos MX en Oaxaca."
  keywords={[
    "equipo arquitectos oaxaca",
    "despacho arquitectos fundadores",
    "arquitectos certificados",
    "directores de obra oaxaca",
    "filosofia arquitectonica",
  ]}
>
  <PageHeader
    badge="Talento y oficio"
    title="Equipo y filosofía"
    subtitle="Arquitectos, ingenieros y diseñadores unidos por la obsesión del detalle y el respeto por el contexto."
    breadcrumbs={[{ label: "Inicio", href: "/" }]}
    bgImage="https://picsum.photos/seed/architecture-studio-team/1200/960"
  />

  <!-- Manifiesto -->
  <section
    class="mx-auto grid max-w-7xl gap-12 px-4 py-24 sm:px-6 lg:grid-cols-12 lg:gap-20 lg:px-8"
  >
    <div class="lg:col-span-7">
      <p
        class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.25em] text-quinary"
      >
        <span class="h-px w-10 bg-quaternary"></span>
        Manifiesto
      </p>
      <blockquote
        class="mt-8 font-display text-3xl font-light italic leading-snug text-light sm:text-4xl lg:text-5xl"
      >
        La verdadera arquitectura no se mide en metros cuadrados, sino en la
        calidad de la luz que acaricia un muro de piedra.
      </blockquote>
    </div>
    <div
      class="space-y-6 text-sm leading-relaxed text-light/70 sm:text-base lg:col-span-5 lg:pt-20"
    >
      <p>
        Fundado en Oaxaca, <strong class="font-semibold text-light"
          >Arquitectos MX</strong
        > nació con la convicción de que la arquitectura es una herramienta transformadora
        que genera orden, paz y bienestar.
      </p>
      <p>
        Equilibramos la herencia constructiva de México con tecnologías
        bioclimáticas y digitales, para crear espacios que dialogan con su
        entorno natural y urbano.
      </p>
    </div>
  </section>

  <!-- Equipo -->
  <section class="border-t border-quaternary/60 bg-primary py-24">
    <div class="mx-auto max-w-7xl space-y-16 px-4 sm:px-6 lg:px-8">
      <p
        class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.25em] text-quinary"
      >
        <span class="h-px w-10 bg-quaternary"></span>
        Dirección
      </p>

      <div
        class="grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          teamMembers.map((member) => (
            <article class="group">
              <div class="aspect-3/4 overflow-hidden border border-quaternary bg-secondary">
                <img
                  src={member.image}
                  alt={member.name}
                  class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
                  loading="lazy"
                />
              </div>
              <div class="mt-5 space-y-3">
                <h3 class="font-display text-2xl font-light text-light">
                  {member.name}
                </h3>
                <p class="font-mono text-[11px] uppercase leading-relaxed tracking-[0.15em] text-tertiary">
                  {member.role}
                </p>
                <p class="border-t border-quaternary/60 pt-3 text-xs leading-relaxed text-light/60">
                  {member.bio}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="¿Quieres platicar con el equipo?"
    description="Siempre estamos abiertos a proyectos desafiantes y alianzas constructivas."
  />
</MainLayout>
