---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { Calendar, User, ArrowLeft, Tag } from "lucide-astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;

// Get related posts
const allPosts = await getCollection("posts");
const relatedPosts = allPosts.filter((p) => p.id !== post.id).slice(0, 2);
---

<MainLayout
  title={`${post.data.title} | Arquitectos MX`}
  description={post.data.description}
  keywords={post.data.tags}
  ogType="article"
  image={post.data.image}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    author: post.data.author,
    tags: post.data.tags,
  }}
>
  <!-- Post Banner Hero -->
  <header
    class="relative w-full py-16 sm:py-20 overflow-hidden border-b border-tertiary bg-secondary"
  >
    <div class="absolute inset-0 z-0">
      <img
        src={post.data.image ||
          "https://picsum.photos/seed/blog-article-detail/1920/800"}
        alt={post.data.title}
        class="w-full h-full object-cover filter brightness-80"
      />
      <div class="absolute inset-0 bg-quaternary/80"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-xs font-bold text-tertiary hover:underline mb-2"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Volver a todas las publicaciones</span>
      </a>

      <div class="flex flex-wrap items-center gap-3 text-xs text-light/80">
        <span
          class="px-3 py-1 rounded-full font-bold bg-tertiary/20 text-tertiary border border-tertiary/40"
        >
          {post.data.category || "Arquitectura"}
        </span>
        <span>•</span>
        <span class="flex items-center gap-1.5">
          <Calendar class="w-3.5 h-3.5 text-tertiary" />
          {
            post.data.pubDate.toLocaleDateString("es-MX", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </span>
        <span>•</span>
        <span class="flex items-center gap-1.5">
          <User class="w-3.5 h-3.5 text-tertiary" />
          {post.data.author}
        </span>
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-black text-light tracking-tight leading-tight"
      >
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-light/85 leading-relaxed">
        {post.data.description}
      </p>
    </div>
  </header>

  <!-- Post Body Content -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <article class="article-body" set:html={post.rendered?.html} />

    <!-- Tags footer -->
    {
      post.data.tags && post.data.tags.length > 0 && (
        <div class="pt-6 border-t border-primary/40 flex flex-wrap items-center gap-2">
          <span class="text-xs font-bold text-light/70 flex items-center gap-1 mr-2">
            <Tag class="w-3.5 h-3.5 text-tertiary" /> Etiquetas:
          </span>
          {post.data.tags.map((tag: string) => (
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-secondary/80 text-light/80 border border-primary/40">
              #{tag}
            </span>
          ))}
        </div>
      )
    }

    <!-- Author & Advice Box -->
    <div
      class="p-6 sm:p-8 rounded-3xl bg-secondary/80 border border-primary/50 flex flex-col sm:flex-row items-center gap-6"
    >
      <div
        class="w-16 h-16 rounded-full bg-tertiary/20 border-2 border-tertiary text-tertiary font-black text-2xl flex items-center justify-center shrink-0"
      >
        MX
      </div>
      <div class="space-y-1 text-center sm:text-left flex-1">
        <h3 class="text-base font-bold text-light">
          Publicado por {post.data.author}
        </h3>
        <p class="text-xs sm:text-sm text-light/75 leading-relaxed">
          Equipo editorial de <strong>Arquitectos MX</strong>.
        </p>
      </div>
      <a
        href="/contacto"
        class="px-6 py-2.5 rounded-full bg-tertiary text-dark font-bold text-xs hover:bg-quinary transition-colors whitespace-nowrap"
      >
        Contactar al Despacho
      </a>
    </div>

    <!-- Related Articles -->
    {
      relatedPosts.length > 0 && (
        <div class="pt-10 border-t border-primary/40 space-y-6">
          <h3 class="text-xl font-bold text-light">Artículos Relacionados</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {relatedPosts.map((rel) => (
              <a
                href={`/blog/${rel.id.replace(/\.md$/, "")}`}
                class="group p-5 rounded-2xl bg-secondary/40 border border-primary/40 hover:border-tertiary/60 transition-all flex flex-col justify-between space-y-3"
              >
                <div class="space-y-1.5">
                  <span class="text-xs font-bold text-tertiary">
                    {rel.data.category || "Arquitectura"}
                  </span>
                  <h4 class="text-base font-bold text-light group-hover:text-tertiary transition-colors">
                    {rel.data.title}
                  </h4>
                  <p class="text-xs text-light/70 line-clamp-2">
                    {rel.data.description}
                  </p>
                </div>
                <span class="text-xs font-bold text-tertiary group-hover:underline">
                  Leer artículo →
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</MainLayout>
